  },
  {
   "ts": "2026-05-15T14:07:37.034505+00:00",
   "event_type": "suggestion_submitted",
   "data": {
    "page": "pas3",
    "text": "caldra fer una batuda de tot el vocabilari utilitzat si és inclosiu i d¡acord amb el marc conceptual de la inclusio i dela nostra identitat",
